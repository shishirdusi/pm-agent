# Copy this file to .env and fill in the values you need.
# .env is gitignored - it will never be committed.

# Required for live extraction (extractor.py). Without this, extraction falls back
# to a cached demo extraction for the sample meetings, or a basic rule-based
# extractor for anything else. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional - only needed if you want run_pipeline.py --write-sheet to push the
# tracker to a real Google Sheet. See sheets_writer.py for the one-time setup
# (service account + sharing the sheet with it). Leave blank to just use the CSV.
GOOGLE_SERVICE_ACCOUNT_JSON=
PM_AGENT_SHEET_ID=

# Optional - protects server.py with a login when both are set. Leave both blank
# for local use (no login required, same as before). REQUIRED before deploying
# anywhere public (Render, Railway, etc.) - otherwise anyone with the URL can use
# your API key's quota. Pick any username/password you want.
APP_USERNAME=
APP_PASSWORD=

# Optional - Slack bot integration. Lets you feed meeting notes in by posting
# them in a Slack channel instead of pasting into the web UI. See the "Slack
# bot" section in README.md for the one-time Slack app setup. Both must be set
# for this to activate; SLACK_NOTES_CHANNEL_ID is optional on top of those two.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_NOTES_CHANNEL_ID=
